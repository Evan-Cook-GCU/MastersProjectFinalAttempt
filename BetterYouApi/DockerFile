# Use the official .NET SDK image as a parent image
FROM mcr.microsoft.com/dotnet/framework/sdk:4.8

# Set the working directory
WORKDIR /app

# Copy the project file
COPY BetterYouApi/BetterYouApi.csproj /app/BetterYouApi/

# Restore dependencies
RUN nuget restore BetterYouApi/BetterYouApi.csproj

# Copy the rest of the application code
COPY BetterYouApi /app/BetterYouApi

# Set the working directory to the project directory
WORKDIR /app/BetterYouApi

# Build the application
RUN msbuild BetterYouApi.csproj -p:Configuration=Release

# Define the entry point for the container
ENTRYPOINT ["BetterYouApi.exe"]
