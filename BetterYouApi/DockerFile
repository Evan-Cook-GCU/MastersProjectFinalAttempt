# Use the Ubuntu base image
FROM ubuntu:20.04

# Install Mono
RUN apt-get update && \
    apt-get install -y mono-complete nuget && \
    rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy the application files
COPY . .
CMD ["tail", "-f", "/dev/null"]
